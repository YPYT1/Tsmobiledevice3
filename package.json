{
  "name": "ts-mobiledevice",
  "version": "0.0.1",
  "description": "TypeScript implementation of pymobiledevice3 - iOS device communication library",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:core": "pnpm --filter @tsmobiledevice/core build",
    "build:server": "pnpm --filter @tsmobiledevice/server build",
    "test": "lerna run test",
    "lint": "lerna run lint",
    "clean": "lerna clean && lerna run clean",
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @tsmobiledevice/server dev\" \"pnpm --filter @tsmobiledevice/web dev\"",
    "dev:server": "pnpm --filter @tsmobiledevice/server dev",
    "dev:web": "pnpm --filter @tsmobiledevice/web dev",
    "start": "concurrently -n server,web -c blue,green \"pnpm --filter @tsmobiledevice/server start\" \"pnpm --filter @tsmobiledevice/web preview\"",
    "start:server": "pnpm --filter @tsmobiledevice/server start",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('husky install', {stdio: 'inherit'})\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lerna": "^8.0.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "author": "YPYT1",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/YPYT1/Tsmobiledevice3.git"
  }
}
