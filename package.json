{
  "name": "ts-mobiledevice",
  "version": "0.0.1",
  "description": "TypeScript implementation of pymobiledevice3 - iOS device communication library",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "test:layer1": "lerna run test:layer1 --scope=@ts-mobiledevice/core",
    "test:layer2": "lerna run test:layer2 --scope=@ts-mobiledevice/core",
    "test:layer3": "lerna run test:layer3 --scope=@ts-mobiledevice/core",
    "lint": "lerna run lint",
    "clean": "lerna clean && lerna run clean",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lerna": "^8.0.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "author": "YPYT1",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/YPYT1/Tsmobiledevice3.git"
  }
}
