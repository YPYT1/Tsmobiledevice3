{
  "name": "@tsmobiledevice/core",
  "version": "0.1.0",
  "description": "Core library for iOS device communication - protocol layers and services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "test": "jest --runInBand",
    "test:layer1": "jest --testPathPattern=usbmux",
    "test:layer2": "jest --testPathPattern=lockdown",
    "test:layer3": "jest --testPathPattern=services",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts'",
    "prepublishOnly": "npm run build",
    "docs": "typedoc"
  },
  "dependencies": {
    "bplist-creator": "^0.0.8",
    "bplist-parser": "^0.3.2",
    "node-forge": "^1.3.1",
    "plist": "^3.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/plist": "^3.0.5",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "ios",
    "iphone",
    "usbmux",
    "lockdown",
    "afc",
    "mobiledevice",
    "typescript",
    "mobile",
    "device-pool"
  ],
  "author": "YPYT1",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YPYT1/Tsmobiledevice3.git",
    "directory": "packages/core"
  }
}
