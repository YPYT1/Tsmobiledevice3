# ts-mobiledevice server environment variables
# Copy to .env and fill in your values

# API authentication (leave blank = open)
API_KEY=

# Server port
PORT=3000

# CORS origin (leave blank = allow all)
CORS_ORIGIN=

# usbmuxd address (leave blank = auto-detect)
USBMUX_ADDRESS=

# Log level: error | warn | log | debug
LOG_LEVEL=log
